<!doctype html>
<html lang="lv">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Mans Apģērbu Veikals</title>
  <meta name="description" content="Vienkāršs statisks apģērbu veikals — demonstrācija. Iekļauts katalogs, grozs un vienkāršs checkout (mailto)." />
  <style>
    :root{--accent:#1f7a8c;--accent-2:#d9ed92;--bg:#f6f8f9;--card:#ffffff;--muted:#6b7280}
    *{box-sizing:border-box}
    body{font-family:Inter, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial; margin:0; background:var(--bg); color:#0f172a}
    header{background:linear-gradient(90deg,var(--accent),#145b6a); color:white; padding:18px 24px; display:flex; align-items:center; justify-content:space-between}
    .brand{display:flex;gap:12px;align-items:center}
    .logo{width:44px;height:44px;background:white;border-radius:8px;display:flex;align-items:center;justify-content:center;color:var(--accent);font-weight:700}
    nav a{color:rgba(255,255,255,0.95); text-decoration:none; margin-left:14px; font-weight:600}
    .container{max-width:1100px;margin:28px auto;padding:0 18px}
    .hero{display:grid;grid-template-columns:1fr 420px;gap:24px;align-items:center}
    .card{background:var(--card);border-radius:12px;padding:18px;box-shadow:0 6px 18px rgba(15,23,42,0.06)}
    h1{margin:0 0 8px 0;font-size:28px}
    p.lead{margin:0;color:var(--muted)}
    .shop-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:18px;margin-top:18px}
    .product{border-radius:10px;overflow:hidden;background:linear-gradient(180deg,rgba(0,0,0,0.03),transparent);display:flex;flex-direction:column}
    .product img{width:100%;height:220px;object-fit:cover}
    .product .info{padding:12px}
    .price{font-weight:700;margin-top:6px}
    .button{display:inline-block;padding:10px 12px;border-radius:8px;background:var(--accent);color:white;text-decoration:none;font-weight:700;border:none;cursor:pointer}
    .btn-ghost{background:transparent;border:1px solid rgba(15,23,42,0.06);color:var(--muted)}
    .topbar{display:flex;gap:12px;align-items:center}
    .cart-btn{background:rgba(255,255,255,0.12);padding:8px 10px;border-radius:8px;color:white;border:none;cursor:pointer}
    footer{padding:28px 18px;text-align:center;color:var(--muted)}
    .flex{display:flex}
    .space{flex:1}
    /* cart drawer */
    .drawer{position:fixed;right:18px;top:80px;width:340px;max-width:90%;background:var(--card);box-shadow:0 20px 50px rgba(2,6,23,0.2);border-radius:12px;padding:14px;display:none;flex-direction:column;z-index:80}
    .drawer.open{display:flex}
    .cart-item{display:flex;gap:10px;align-items:center;padding:10px 6px;border-bottom:1px dashed rgba(15,23,42,0.05)}
    .cart-item img{width:64px;height:64px;object-fit:cover;border-radius:8px}
    .qty{display:inline-flex;align-items:center;gap:6px}
    .muted{color:var(--muted)}
    /* responsive */
    @media (max-width:880px){.hero{grid-template-columns:1fr;}.drawer{right:8px;left:8px;top:auto;bottom:18px;width:auto;max-width:calc(100% - 36px)}}
    /* product modal */
    .modal-back{position:fixed;inset:0;background:rgba(2,6,23,0.45);display:none;align-items:center;justify-content:center;z-index:90}
    .modal-back.open{display:flex}
    .modal{width:960px;max-width:94%;background:var(--card);border-radius:12px;padding:18px;display:grid;grid-template-columns:1fr 1fr;gap:12px}
    .small{font-size:14px}
    input[type="number"]{width:64px;padding:6px}
    /* header search */
    .search{background:white;padding:8px;border-radius:8px;display:flex;gap:8px;align-items:center}
    .search input{border:0;outline:none}
  </style>
</head>
<body>
  <header>
    <div class="brand">
      <div class="logo">AV</div>
      <div>
        <div style="font-weight:700">Mans Apģērbu Veikals</div>
        <div style="font-size:12px;color:rgba(255,255,255,0.9)">Bezmaksas piegāde virs €70</div>
      </div>
    </div>
    <div class="topbar">
      <nav>
        <a href="#home" onclick="navigate('home')">Sākums</a>
        <a href="#shop" onclick="navigate('shop')">Veikals</a>
        <a href="#about" onclick="navigate('about')">Par mums</a>
        <a href="#contact" onclick="navigate('contact')">Kontakti</a>
      </nav>
      <div class="space"></div>
      <div class="search" style="margin-right:10px">
        <input id="searchInput" placeholder="Meklēt..." oninput="renderProducts()" />
      </div>
      <button class="cart-btn" onclick="toggleCart()">Grozs (<span id="cartCount">0</span>)</button>
    </div>
  </header>

  <main class="container">
    <section id="home" class="hero">
      <div class="card">
        <h1>Jaunākā kolekcija</h1>
        <p class="lead">Moderns dizains, ērtas kvalitātes drēbes — izvēlies un pasūti vienkārši.</p>
        <div style="margin-top:14px">
          <button class="button" onclick="navigate('shop')">Apskatīt produktus</button>
          <button class="btn-ghost" style="margin-left:8px" onclick="navigate('about')">Uzzināt vairāk</button>
        </div>
        <div style="margin-top:18px;display:flex;gap:12px">
          <div class="card" style="flex:1"> <strong>Ātra piegāde</strong><div class="small muted">1-3 darba dienas Latvijā</div></div>
          <div class="card" style="flex:1"> <strong>Atgriešana 14 dienu</strong><div class="small muted">Bez jautājumiem</div></div>
        </div>
      </div>

      <div class="card">
        <img src="https://images.unsplash.com/photo-1520975919562-1a0f6a0f536f?q=80&w=1200&auto=format&fit=crop&ixlib=rb-4.0.3&s=placeholder" alt="Hero" style="width:100%;height:320px;object-fit:cover;border-radius:8px;margin-bottom:10px">
        <div style="display:flex;justify-content:space-between;align-items:center">
          <div>
            <div style="font-weight:700">Izcila kvalitāte</div>
            <div class="small muted">Dizains + komforts</div>
          </div>
          <div><button class="button" onclick="navigate('shop')">Skatīt kolekciju</button></div>
        </div>
      </div>
    </section>

    <section id="shop" style="display:none">
      <h2>Veikals</h2>
      <div id="products" class="shop-grid"></div>
    </section>

    <section id="about" style="display:none">
      <div class="card">
        <h2>Par mums</h2>
        <p>Mēs esam neliels zīmols, kas specializējas ērtā, mūsdienīgā apģērbā. Mūsu mērķis — radīt kvalitatīvas drēbes, kas labi izskatās un kalpo ilgi.</p>
        <ul>
          <li>Ilgtspējīgi materiāli</li>
          <li>Atbalsts vietējiem ražotājiem</li>
          <li>Bezmaksas atgriešana 14 dienu</li>
        </ul>
      </div>
    </section>

    <section id="contact" style="display:none">
      <div class="card">
        <h2>Kontakti</h2>
        <p>Raksti: <a href="mailto:info@mansveikals.lv">info@mansveikals.lv</a></p>
        <p>Telefons: +371 20000000</p>
        <h3>Pasūtījuma forma</h3>
        <form id="orderForm" onsubmit="handleOrder(event)">
          <label>Vārds<br><input id="name" required /></label><br><br>
          <label>E-pasts<br><input id="email" type="email" required /></label><br><br>
          <label>Piezīmes<br><textarea id="notes"></textarea></label><br><br>
          <button class="button" type="submit">Sūtīt pasūtījumu</button>
        </form>
      </div>
    </section>

  </main>

  <div class="drawer" id="cartDrawer" aria-hidden="true">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px">
      <strong>Grozs</strong>
      <button onclick="toggleCart()" class="btn-ghost">Aizvērt</button>
    </div>
    <div id="cartItems" style="overflow:auto;max-height:320px"></div>
    <div style="margin-top:10px;display:flex;justify-content:space-between;align-items:center">
      <div>
        <div class="muted small">Kopā:</div>
        <div id="cartTotal" style="font-weight:700">€0.00</div>
      </div>
      <div>
        <button class="button" onclick="checkout()">Noformēt pasūtījumu</button>
      </div>
    </div>
  </div>

  <div class="modal-back" id="modalBack">
    <div class="modal card">
      <div>
        <img id="modalImg" src="" alt="" style="width:100%;height:320px;object-fit:cover;border-radius:8px">
      </div>
      <div>
        <h3 id="modalTitle">Produkts</h3>
        <div id="modalDesc" class="muted small">Apraksts</div>
        <div class="price" id="modalPrice">€0.00</div>
        <div style="margin-top:8px">Daudzums: <input id="modalQty" type="number" min="1" value="1" /></div>
        <div style="margin-top:12px">
          <button class="button" onclick="addModalToCart()">Pievienot grozam</button>
          <button class="btn-ghost" style="margin-left:8px" onclick="closeModal()">Atcelt</button>
        </div>
      </div>
    </div>
  </div>

  <footer>
    <div class="container">
      <div style="display:flex;gap:12px;align-items:center;justify-content:center">
        <div class="muted">© "Mans Apģērbu Veikals" — Demo</div>
      </div>
    </div>
  </footer>

  <script>
    // --- sample products ---
    const PRODUCTS = [
      {id: 'p1', title: 'Tumši džemperis', price: 49.00, img: 'https://images.unsplash.com/photo-1520975919562-1a0f6a0f536f?q=80&w=1000&auto=format&fit=crop&ixlib=rb-4.0.3&s=placeholder', desc: 'Klasisks tumšs džemperis no kokvilnas.'},
      {id: 'p2', title: 'Balta krekls', price: 29.00, img: 'https://images.unsplash.com/photo-1520975919562-1a0f6a0f536f?q=80&w=1000&auto=format&fit=crop&ixlib=rb-4.0.3&s=placeholder', desc: 'Ikdienas balts krekls ar ērtu griezumu.'},
      {id: 'p3', title: 'Melnas bikses', price: 59.00, img: 'https://images.unsplash.com/photo-1520975919562-1a0f6a0f536f?q=80&w=1000&auto=format&fit=crop&ixlib=rb-4.0.3&s=placeholder', desc: 'Šauras melnas bikses, elastīgs audums.'},
      {id: 'p4', title: 'Vasarnieku t-krekls', price: 19.00, img: 'https://images.unsplash.com/photo-1520975919562-1a0f6a0f536f?q=80&w=1000&auto=format&fit=crop&ixlib=rb-4.0.3&s=placeholder', desc: 'Viegls T-krekls ar apdruku.'},
      {id: 'p5', title: 'Kapuce ar rāvēju', price: 65.00, img: 'https://images.unsplash.com/photo-1520975919562-1a0f6a0f536f?q=80&w=1000&auto=format&fit=crop&ixlib=rb-4.0.3&s=placeholder', desc: 'Siltā kapuce ar rāvēju un kabatām.'},
      {id: 'p6', title: 'Sporta šorti', price: 24.00, img: 'https://images.unsplash.com/photo-1520975919562-1a0f6a0f536f?q=80&w=1000&auto=format&fit=crop&ixlib=rb-4.0.3&s=placeholder', desc: 'Ērti šorti treniņiem.'}
    ];

    // --- simple router ---
    function navigate(page){
      ['home','shop','about','contact'].forEach(id=>document.getElementById(id).style.display = (id===page?'block':'none'));
      if(page==='shop') renderProducts();
      window.location.hash = page;
    }
    // init from hash
    const initial = window.location.hash.replace('#','') || 'home';
    navigate(initial);

    // --- products rendering ---
    function renderProducts(){
      const q = document.getElementById('searchInput').value.toLowerCase();
      const container = document.getElementById('products'); container.innerHTML='';
      const filtered = PRODUCTS.filter(p=>p.title.toLowerCase().includes(q) || p.desc.toLowerCase().includes(q));
      filtered.forEach(p=>{
        const el = document.createElement('div'); el.className='product card';
        el.innerHTML = `
          <img src="${p.img}" alt="${p.title}">
          <div class="info">
            <div style="display:flex;justify-content:space-between;align-items:center">
              <div>
                <div style="font-weight:700">${p.title}</div>
                <div class="small muted">${p.desc}</div>
                <div class="price">€${p.price.toFixed(2)}</div>
              </div>
            </div>
            <div style="margin-top:10px;display:flex;gap:8px;align-items:center">
              <button class="button" onclick='openModal("${p.id}")'>Skatīt</button>
              <button class="btn-ghost" onclick='addToCart("${p.id}")'>Pievienot grozam</button>
            </div>
          </div>
        `;
        container.appendChild(el);
      })
    }

    // --- modal ---
    let modalProduct = null;
    function openModal(id){
      modalProduct = PRODUCTS.find(p=>p.id===id);
      document.getElementById('modalImg').src = modalProduct.img;
      document.getElementById('modalTitle').innerText = modalProduct.title;
      document.getElementById('modalDesc').innerText = modalProduct.desc;
      document.getElementById('modalPrice').innerText = '€' + modalProduct.price.toFixed(2);
      document.getElementById('modalQty').value = 1;
      document.getElementById('modalBack').classList.add('open');
    }
    function closeModal(){ document.getElementById('modalBack').classList.remove('open'); }
    function addModalToCart(){ const qty = Number(document.getElementById('modalQty').value)||1; addToCart(modalProduct.id, qty); closeModal(); }

    // --- cart ---
    function loadCart(){ try{ return JSON.parse(localStorage.getItem('cart')||'{}'); }catch(e){return {}} }
    function saveCart(cart){ localStorage.setItem('cart', JSON.stringify(cart)); updateCartUI(); }
    function addToCart(id, qty=1){ const cart = loadCart(); cart[id] = (cart[id]||0)+qty; saveCart(cart); }
    function removeFromCart(id){ const cart = loadCart(); delete cart[id]; saveCart(cart); }
    function changeQty(id, qty){ const cart = loadCart(); if(qty<=0) delete cart[id]; else cart[id]=qty; saveCart(cart); }
    function toggleCart(){ document.getElementById('cartDrawer').classList.toggle('open'); updateCartUI(); }
    function updateCartUI(){ const cart = loadCart(); const itemsDiv = document.getElementById('cartItems'); itemsDiv.innerHTML=''; let total=0, count=0;
      Object.keys(cart).forEach(id=>{
        const p = PRODUCTS.find(x=>x.id===id); const q=cart[id]; count+=q; total += p.price*q;
        const line = document.createElement('div'); line.className='cart-item';
        line.innerHTML = `
          <img src="${p.img}" alt="${p.title}">
          <div style="flex:1">
            <div style="font-weight:700">${p.title}</div>
            <div class="small muted">€${p.price.toFixed(2)} x ${q} = €${(p.price*q).toFixed(2)}</div>
          </div>
          <div style="display:flex;flex-direction:column;gap:6px;align-items:flex-end">
            <div class="qty"><button onclick='changeQty("${id}",${q-1})' class="btn-ghost">−</button><div style="padding:6px">${q}</div><button onclick='changeQty("${id}",${q+1})' class="btn-ghost">+</button></div>
            <button class="btn-ghost" onclick='removeFromCart("${id}")'>Noņemt</button>
          </div>
        `;
        itemsDiv.appendChild(line);
      });
      document.getElementById('cartTotal').innerText = '€' + total.toFixed(2);
      document.getElementById('cartCount').innerText = count;
    }
    updateCartUI();

    // --- checkout (mailto fallback) ---
    function checkout(){ const cart = loadCart(); if(Object.keys(cart).length===0){alert('Grozs ir tukšs'); return;} // open contact form if user prefers
      // Prepare order summary
      let body = 'Pasūtījums%0A%0A'; let total=0;
      Object.keys(cart).forEach(id=>{ const p=PRODUCTS.find(x=>x.id===id); const q=cart[id]; total += p.price*q; body += encodeURIComponent(`${p.title} — ${q} x €${p.price.toFixed(2)} = €${(p.price*q).toFixed(2)}\n`); });
      body += encodeURIComponent('\nKopā: €' + total.toFixed(2) + '\n\nLūdzu norādiet piegādes adresi un kontaktinformāciju.');
      const to = 'info@mansveikals.lv';
      const mailto = `mailto:${to}?subject=${encodeURIComponent('Jauns pasūtījums')}&body=${body}`;
      window.location.href = mailto;
    }

    function handleOrder(e){ e.preventDefault(); // take contact form data and append cart
      const name = document.getElementById('name').value;
      const email = document.getElementById('email').value;
      const notes = document.getElementById('notes').value;
      const cart = loadCart(); if(Object.keys(cart).length===0){alert('Grozs ir tukšs — pievienojiet produktus!'); return}
      let body = `Pasūtījums\n\nVārds: ${name}\nE-pasts: ${email}\nPiezīmes: ${notes}\n\n`;
      let total=0; Object.keys(cart).forEach(id=>{ const p=PRODUCTS.find(x=>x.id===id); const q=cart[id]; total += p.price*q; body += `${p.title} — ${q} x €${p.price.toFixed(2)} = €${(p.price*q).toFixed(2)}\n`; });
      body += `\nKopā: €${total.toFixed(2)}\n`;
      const mailto = `mailto:info@mansveikals.lv?subject=${encodeURIComponent('Pasūtījums no ' + name)}&body=${encodeURIComponent(body)}`;
      window.location.href = mailto;
    }

    // allow clicking outside modal to close
    document.getElementById('modalBack').addEventListener('click', (e)=>{ if(e.target===document.getElementById('modalBack')) closeModal(); });

    // small enhancement: save cart on page unload
    window.addEventListener('beforeunload', ()=>{ saveCart(loadCart()); });

    // keyboard: press 'c' to toggle cart (debug)
    window.addEventListener('keydown', (e)=>{ if(e.key==='c') toggleCart(); });
  </script>
</body>
</html>
